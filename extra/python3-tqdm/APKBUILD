45c42be7b70462f5b4ea3f6a11c4fb13e8e44e2f889e96a4b76a0b15d436e0ea1ad9eb50222ac425a97e9ca65749a729dfbdb77b151a0acb99614d0530a9f77d  001-utils_py.patch
"
