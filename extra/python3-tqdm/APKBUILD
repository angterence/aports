# Alpine-Contributor: Celeste <cielesti@protonmail.com>
# Alpine-Maintainer: Liliana <me@iodomi.eu>
# Maintainer: Terence Ang <taang@qnx.com>
pkgname=python3-tqdm
pkgver=4.70.1
pkgrel=0
pkgdesc="Fast, Extensible Progress Meter"
url="https://pypi.org/project/tqdm"
arch="noarch"
license="MIT"
makedepends="
	python3-gpep517
	python3-setuptools_scm
	python3-wheel
 "
checkdepends="
	python3-numpy
	python3-pytest
	python3-pytest-asyncio
	python3-pytest-timeout
"
source="
	https://files.pythonhosted.org/packages/source/t/tqdm/tqdm-$pkgver.tar.gz
	001-utils_py.patch
"
builddir="$srcdir/tqdm-$pkgver"


build() {
	export SETUPTOOLS_SCM_PRETEND_VERSION="$pkgver"
	gpep517 build-wheel \
		--wheel-dir .dist \
		--output-fd 3 3>&1 >&2
}

check() {
	python3 -m venv --clear --without-pip --system-site-packages .testenv
	.testenv/bin/python3 -m installer .dist/*.whl
	.testenv/bin/python3 -m pytest
}

package() {
	python3 -m installer -d "$pkgdir" .dist/*.whl

	ln -s tqdm "$pkgdir"/usr/bin/tqdm-3
}


sha512sums="
