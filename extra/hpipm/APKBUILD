28ad27600efc2796abcf30eab8bc096fd1857230b6c91ec9f9268ce7426f7726c8d44a09c63f7e45251ef7563877c0c9b02415eee0a18d1662da5a9b1e4cb79b  001-CMakeLists.patch
"
