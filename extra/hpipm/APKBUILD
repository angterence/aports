# Maintainer: Terence Ang <taang@qnx.com>
pkgname=hpipm
pkgver=0.1.3_git20260918
_commit="bad1123a96136fce3cdd8bbcbe24b853d012b840"
pkgrel=0
pkgdesc="High-performance interior-point-method QP and QCQP solvers"
url="https://github.com/giaf/hpipm"
arch="all"
license="BSD-2-Clause"
depends="blasfeo"
depends_dev="blasfeo-dev"
makedepends="
    $depends_dev
    cmake
"
subpackages="$pkgname-dev"
source="
    $pkgname-$_commit.tar.gz::https://github.com/giaf/hpipm/archive/$_commit.tar.gz
    001-CMakeLists.patch
"
builddir="$srcdir/$pkgname-$_commit"

build() {
    cmake -B build -S . \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DBUILD_SHARED_LIBS=ON \
        -DHPIPM_TESTING=ON \
        -DBLASFEO_PATH=/usr

    cmake --build build -j"$(nproc)"
}

package() {
    DESTDIR="$pkgdir" cmake --install build

    mv "$pkgdir"/usr/include/ "$pkgdir"/usr/include.tmp
    mkdir -p "$pkgdir/usr/include/hpipm"
    mv "$pkgdir"/usr/include.tmp "$pkgdir"/usr/include/hpipm
    mv "$pkgdir"/usr/include/hpipm/include.tmp "$pkgdir"/usr/include/hpipm/include

    header_list=$(find "$pkgdir"/usr/include/hpipm/include -type f)
    cd "$pkgdir"/usr/include
    for i in $header_list; do
       file_name=$(basename $i)
       ln -sf /usr/include/hpipm/include/$file_name $file_name
    done
}

dev() {
    default_dev
    depends="
        $depends
	$pkgname=$pkgver-r$pkgrel
    "
}

check() {
    cd build
    tests="
        d_cond
        d_dense_qp
        d_ocp_qp
        d_part_cond
        d_tree_ocp_qp
    "
    for i in $tests; do
        echo "Testing $i"

        ./test_problems/$i >"/tmp/$i.log" 2>&1 || {
            echo "FAILED: $i"
            cat "/tmp/$i.log"
            return 1
        }

        echo "PASSED: $i"
    done
}

